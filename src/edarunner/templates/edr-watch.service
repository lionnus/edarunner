# edr watch as a systemd user unit. Install:
#   cp edr-watch.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now edr-watch
# The unit survives a logout only after: loginctl enable-linger $$USER
[Unit]
Description=edr watch ($project)
After=network-online.target

[Service]
WorkingDirectory=$project_root
# A user service starts with a bare PATH; the tools of the user live in ~/.local/bin.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$edr watch
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
