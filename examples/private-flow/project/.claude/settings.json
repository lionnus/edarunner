{
  "permissions": {
    "deny": [
      "Read(//path/to/nda/**)",
      "Read(//path/to/project/data/private/**)",
      "Read(~/.edr/**)",
      "Read(//path/to/rtl-wt/**/nonfree/**)",
      "Read(//path/to/scratch/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["edr *"],
    "filesystem": {
      "denyRead": ["/path/to/nda", "/path/to/project/data/private", "~/.edr", "/path/to/scratch"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && edr brief" }]
      }
    ]
  }
}
